        "plt.xlabel('POS')\n",
        "plt.ylabel('F1')\n",
        "plt.xticks(rotation=45, ha='right') # Rotar etiquetas para mejor legibilidad\n",
        "plt.ylim(0, 1)\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
        "plt.legend(title='POS-taggers', loc='best', bbox_to_anchor=(1, 1) )\n",
        "plt.tight_layout()\n",
        "plt.savefig('f1.png')\n",
